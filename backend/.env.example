# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://timetracker:timetracker@db:5432/timetracker?schema=public"

# Server
PORT=4000
NODE_ENV=development

# URL of the frontend, used for CORS and post-login redirects
FRONTEND_URL="http://localhost:3000"

# Secret used to sign JWT session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Google OAuth 2.0 credentials.
# Create them at https://console.cloud.google.com/apis/credentials
#   1. Create an OAuth client ID of type "Web application"
#   2. Add an Authorized redirect URI matching GOOGLE_CALLBACK_URL below
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
