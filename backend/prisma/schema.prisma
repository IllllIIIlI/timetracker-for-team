generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  googleId   String   @unique
  email      String   @unique
  name       String
  avatarUrl  String?
  createdAt  DateTime @default(now())

  // SHA-256 hash of a personal API token, for calling the API (e.g. start/stop
  // a timer) without a browser session. The raw token is shown to the user
  // only once, when generated.
  apiKeyHash String? @unique

  ownedProjects Project[]
  memberships   ProjectMember[]
  timeEntries   TimeEntry[]
}

model Project {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  members     ProjectMember[]
  invites     ProjectInvite[]
  timeEntries TimeEntry[]

  @@unique([ownerId, name])
}

// Who can see / log time on a project.
model ProjectMember {
  id        String   @id @default(uuid())
  role      String   @default("MEMBER") // "OWNER" | "MEMBER"
  joinedAt  DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// An email invited to a project that hasn't signed in yet. Resolved into a
// ProjectMember automatically the first time that email signs in with Google.
model ProjectInvite {
  id        String   @id @default(uuid())
  email     String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
}

model TimeEntry {
  id              String    @id @default(uuid())
  description     String?
  startTime       DateTime
  endTime         DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}
