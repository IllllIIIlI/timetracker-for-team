# Read by docker-compose.yml (copy to ".env" in this same folder — docker
# compose picks that up automatically, no need to pass these on the command
# line every time).

# Your public domain, once its DNS A record points at this machine's public
# IP and your router forwards ports 80+443 here. Caddy will automatically
# get it a real Let's Encrypt certificate. Leave unset (or "localhost") to
# use Caddy's own locally-trusted certificate instead.
DOMAIN=timet.space

# Where the frontend should call the API. Should match DOMAIN over HTTPS
# once Caddy is fronting everything; use the LAN nip.io address for a
# LAN-only deployment instead.
VITE_API_URL=https://timet.space
